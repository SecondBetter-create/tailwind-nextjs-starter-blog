&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#148F77;fontColor=#0E6251;fontSize=13;align=center;verticalAlign=middle;spacing=10;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxGeometry x=&quot;920&quot; y=&quot;540&quot; width=&quot;360&quot; height=&quot;125&quot; as=&quot;geometry&quot;/&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/mxCell&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxCell id=&quot;accrual&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; value=&quot;Opbouw van het recht&amp;amp;lt;br&amp;amp;gt;&amp;amp;lt;br&amp;amp;gt;De AOW kent wel opbouw van een uitkeringsrecht, maar geen persoonlijke vermogensopbouw.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#17A589;fontColor=#0E6251;fontSize=13;align=center;verticalAlign=middle;spacing=10;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxGeometry x=&quot;920&quot; y=&quot;715&quot; width=&quot;170&quot; height=&quot;145&quot; as=&quot;geometry&quot;/&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/mxCell&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxCell id=&quot;age&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; value=&quot;AOW-leeftijd&amp;amp;lt;br&amp;amp;gt;&amp;amp;lt;br&amp;amp;gt;De uitkering begint wanneer iemand de voor hem of haar geldende AOW-leeftijd bereikt.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#17A589;fontColor=#0E6251;fontSize=13;align=center;verticalAlign=middle;spacing=10;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxGeometry x=&quot;1110&quot; y=&quot;715&quot; width=&quot;170&quot; height=&quot;145&quot; as=&quot;geometry&quot;/&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/mxCell&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxCell id=&quot;amount&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; value=&quot;Hoogte van de uitkering&amp;amp;lt;br&amp;amp;gt;&amp;amp;lt;br&amp;amp;gt;De uiteindelijke AOW-uitkering hangt onder andere samen met de opgebouwde verzekeringsjaren en de leefsituatie.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#148F77;fontColor=#0E6251;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacing=12;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxGeometry x=&quot;920&quot; y=&quot;910&quot; width=&quot;360&quot; height=&quot;145&quot; as=&quot;geometry&quot;/&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/mxCell&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxCell id=&quot;not-salary&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; value=&quot;Belangrijk&amp;amp;lt;br&amp;amp;gt;&amp;amp;lt;br&amp;amp;gt;De AOW is een basisvoorziening. De uitkering is niet rechtstreeks gebaseerd op je vroegere salaris of op hoeveel geld persoonlijk voor jou is belegd.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#922B21;fontSize=13;align=left;verticalAlign=top;spacing=12;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxGeometry x=&quot;920&quot; y=&quot;1100&quot; width=&quot;360&quot; height=&quot;155&quot; as=&quot;geometry&quot;/&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/mxCell&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxCell id=&quot;e-rights-insured&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;rights&quot; target=&quot;insured&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#148F77;endArrow=classic;&quot;&a