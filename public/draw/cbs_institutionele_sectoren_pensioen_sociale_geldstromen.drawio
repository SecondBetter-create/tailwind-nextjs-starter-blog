p;&amp;nbsp; value=&quot;Solidariteit tussen generaties&amp;amp;lt;br&amp;amp;gt;&amp;amp;lt;br&amp;amp;gt;De huidige samenleving financiert de basisuitkering van de huidige generatie ouderen. Een volgende generatie doet dat later opnieuw.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2471A3;fontColor=#1A5276;fontSize=13;align=left;verticalAlign=top;spacing=12;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxGeometry x=&quot;500&quot; y=&quot;1040&quot; width=&quot;360&quot; height=&quot;155&quot; as=&quot;geometry&quot;/&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/mxCell&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxCell id=&quot;e-working-payers&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;working&quot; target=&quot;current-payers&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2471A3;endArrow=classic;&quot;&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;/&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/mxCell&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;mxCell id=&quot;e-payers-premiums&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;current-payers&quot; target=&quot;pr