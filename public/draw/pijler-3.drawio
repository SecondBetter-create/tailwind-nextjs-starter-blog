<mxfile host="app.diagrams.net" modified="2026-10-07T16:20:00.000Z" agent="Microsoft 365 Copilot" version="24.7.17" type="device">
  <diagram id="pijler3" name="Pijler 3">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Pijler 3 - Zelf aanvullend pensioen opbouwen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D35400;strokeColor=#A04000;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="30" width="1000" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Pijler 1 geeft de AOW-basis. Pijler 2 bouwt pensioen op via de werkgever. Pijler 3 vult een aantoonbaar pensioentekort fiscaal vriendelijk aan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontColor=#6E2C00;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="120" width="1100" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="PIJLER 1&lt;br&gt;&lt;b&gt;AOW&lt;/b&gt;&lt;br&gt;Collectieve basis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4D03F;strokeColor=#B7950B;fontColor=#6E2C00;fontStyle=1;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="180" y="250" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="p2" value="PIJLER 2&lt;br&gt;&lt;b&gt;Werkgeverspensioen&lt;/b&gt;&lt;br&gt;Opbouw via werk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5DADE2;strokeColor=#21618C;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="gap" value="Pensioentekort?&lt;br&gt;Pijler 1 + 2 zijn niet altijd genoeg" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#922B21;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="970" y="235" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="p3" value="PIJLER 3&lt;br&gt;&lt;b&gt;Lijfrente, banksparen of pensioenbeleggen&lt;/b&gt;&lt;br&gt;Eigen fiscale aanvulling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E67E22;strokeColor=#A04000;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="240" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="p1" target="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7F8C8D;strokeWidth=2;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2g" edge="1" parent="1" source="p2" target="gap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7F8C8D;strokeWidth=2;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg3" edge="1" parent="1" source="gap" target="p3" value="aanvullen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D35400;strokeWidth=2;endArrow=classic;fontStyle=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="grossHead" value="1. Inleggen met bruto geld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#239B56;strokeColor=#196F3D;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="normal" value="&lt;b&gt;Gewoon sparen uit netto inkomen&lt;/b&gt;&lt;br&gt;&lt;br&gt;€ 10.000 bruto inkomen&lt;br&gt;- € 3.575 box-1-heffing (voorbeeld 2026, eerste schijf vóór AOW)&lt;br&gt;= € 6.425 beschikbaar om te sparen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#922B21;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="pensionSave" value="&lt;b&gt;Fiscaal aftrekbaar inleggen&lt;/b&gt;&lt;br&gt;&lt;br&gt;€ 10.000 storting binnen jaar-/reserveringsruimte&lt;br&gt;Indicatieve belastingvermindering: € 3.575&lt;br&gt;Netto last: € 6.425&lt;br&gt;&lt;b&gt;Volledige € 10.000 wordt belegd&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#239B56;fontColor=#145A32;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="385" y="570" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="grossNote" value="Niet belastingvrij, maar belastinguitstel: latere lijfrente-uitkeringen vallen in box 1. Het echte voordeel hangt af van inkomen, aftrekruimte, heffingskortingen en het tarief bij uitkering." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#D4AC0D;fontColor=#7D6608;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="100" y="800" width="560" height="100" as="geometry"/></mxCell>

        <mxCell id="boxHead" value="2. Box 1 vóór en na AOW (2026)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7D3C98;strokeColor=#512E5F;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="470" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="beforeAow" value="&lt;b&gt;Jonger dan AOW-leeftijd&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tot en met € 38.883: 35,75%&lt;br&gt;€ 38.883 t/m € 78.426: 37,56%&lt;br&gt;Boven € 78.426: 49,50%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBDEF0;strokeColor=#7D3C98;fontColor=#512E5F;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="770" y="570" width="240" height="180" as="geometry"/></mxCell>
        <mxCell id="afterAow" value="&lt;b&gt;AOW-leeftijd bereikt, geboren 1946 of later&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tot en met € 38.883: 17,85%&lt;br&gt;€ 38.883 t/m € 78.426: 37,56%&lt;br&gt;Boven € 78.426: 49,50%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#7D3C98;fontColor=#512E5F;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1030" y="570" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="boxDifference" value="&lt;b&gt;Verschil in de eerste schijf: 17,90 procentpunt&lt;/b&gt;&lt;br&gt;&lt;br&gt;Na de AOW-leeftijd vervalt de AOW-premiecomponent. Daardoor kan aftrek tijdens het werkzame leven en belastingheffing bij latere uitkering gunstig uitpakken. Dit is geen garantie: het resultaat hangt af van je totale inkomen en heffingskortingen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#7D3C98;fontColor=#512E5F;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="820" y="795" width="440" height="145" as="geometry"/></mxCell>

        <mxCell id="spaceHead" value="3. Jaarruimte 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2471A3;strokeColor=#1A5276;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="470" width="430" height="60" as="geometry"/></mxCell>
        <mxCell id="formula" value="&lt;b&gt;Vereenvoudigde hoofdformule&lt;/b&gt;&lt;br&gt;&lt;br&gt;30% × premiegrondslag&lt;br&gt;- vermindering voor pensioenopbouw&lt;br&gt;= jaarruimte&lt;br&gt;&lt;br&gt;Premiegrondslag = relevant inkomen - AOW-franchise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2471A3;fontColor=#154360;fontSize=13;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1350" y="570" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="limits" value="&lt;b&gt;2026-grenzen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aftoppingsgrens inkomen: € 137.800&lt;br&gt;AOW-franchise: € 19.172&lt;br&gt;Maximale premiegrondslag: € 118.628&lt;br&gt;Maximale jaarruimte: € 35.589" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2471A3;fontColor=#154360;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1680" y="570" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="exampleSpace" value="&lt;b&gt;Rekenvoorbeeld zonder pensioenopbouw in 2025&lt;/b&gt;&lt;br&gt;&lt;br&gt;Relevant inkomen: € 60.000&lt;br&gt;- franchise € 19.172&lt;br&gt;= premiegrondslag € 40.828&lt;br&gt;30% = € 12.248,40 jaarruimte 2026&lt;br&gt;&lt;br&gt;Bij pensioenopbouw wordt de wettelijk bepaalde vermindering nog afgetrokken." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#17A589;fontColor=#0E6251;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1430" y="815" width="470" height="190" as="geometry"/></mxCell>

        <mxCell id="reserveHead" value="4. Reserveringsruimte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#148F77;strokeColor=#0E6251;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1"><mxGeometry x="110" y="1010" width="430" height="60" as="geometry"/></mxCell>
        <mxCell id="reserveText" value="Niet-benutte jaarruimte uit eerdere jaren kun je later alsnog gebruiken. Dit heet reserveringsruimte. Gebruik voor de exacte berekening de gegevens per jaar en voorkom dat oudere ruimte vervalt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#148F77;fontColor=#0E6251;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="1110" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="reserveLimit" value="&lt;b&gt;Maximum reserveringsruimte 2026&lt;/b&gt;&lt;br&gt;&lt;br&gt;€ 42.753&lt;br&gt;&lt;br&gt;De werkelijk bruikbare ruimte kan lager zijn en hangt af van je niet-benutte jaarruimtes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#148F77;fontColor=#0E6251;fontSize=13;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="1110" width="260" height="150" as="geometry"/></mxCell>

        <mxCell id="whyMaxHead" value="5. Waarom is de ruimte begrensd?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7950B;strokeColor=#7D6608;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="1010" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="whyMax" value="De aftrek is bedoeld om een pensioentekort aan te vullen. Zonder maximum zou inkomen onbeperkt kunnen worden uitgesteld en buiten de normale directe belastingheffing kunnen worden geplaatst. Daarom koppelt de wet de aftrek aan inkomen, franchise, pensioenopbouw en wettelijke maxima." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#B7950B;fontColor=#7D6608;fontSize=13;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="800" y="1110" width="480" height="165" as="geometry"/></mxCell>

        <mxCell id="resultHead" value="6. Resultaat: drie pijlers samen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;strokeColor=#641E16;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1"><mxGeometry x="1400" y="1050" width="480" height="60" as="geometry"/></mxCell>
        <mxCell id="result" value="&lt;b&gt;Pijler 1&lt;/b&gt; AOW-basis&lt;br&gt;+&lt;br&gt;&lt;b&gt;Pijler 2&lt;/b&gt; werkgeverspensioen&lt;br&gt;+&lt;br&gt;&lt;b&gt;Pijler 3&lt;/b&gt; eigen fiscale aanvulling&lt;br&gt;=&lt;br&gt;&lt;b&gt;Totaal pensioeninkomen&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#922B21;fontColor=#641E16;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="1150" width="440" height="220" as="geometry"/></mxCell>
        <mxCell id="warning" value="Educatief voorbeeld. Controleer je persoonlijke jaarruimte en reserveringsruimte met het officiële hulpmiddel van de Belastingdienst of met een adviseur. Tarieven en grenzen kunnen jaarlijks wijzigen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;fontColor=#424949;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="520" y="1380" width="1280" height="65" as="geometry"/></mxCell>

        <mxCell id="e3gross" edge="1" parent="1" source="p3" target="grossHead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D35400;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3box" edge="1" parent="1" source="p3" target="boxHead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D35400;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3space" edge="1" parent="1" source="p3" target="spaceHead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D35400;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSpaceReserve" edge="1" parent="1" source="spaceHead" target="reserveHead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#148F77;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSpaceMax" edge="1" parent="1" source="spaceHead" target="whyMaxHead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B7950B;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSpaceResult" edge="1" parent="1" source="spaceHead" target="resultHead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#922B21;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
